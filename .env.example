# IMPORTANT — which file to put this in:
# Next.js loads `.env.local` in EVERY mode (dev AND `next build`/`next start`),
# so anything emulator-related must NOT live there — it would leak into a real
# production run and silently redirect Admin SDK calls (Firestore, Auth token
# verification) to the local emulator, causing hard-to-diagnose failures like
# "Firebase ID token has invalid signature" against a real, valid token.
#   - Real project config          -> .env.production.local
#   - Local emulator config        -> .env.development.local (NEVER .env.local)
# See `npm run emulators` for the emulator suite itself.

# Firebase client SDK (public — exposed to the browser)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin SDK (server-only — service account, never exposed to the client)
# Generate from Firebase Console > Project Settings > Service Accounts > Generate new private key
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Keep the literal \n line breaks; they are unescaped at runtime.
FIREBASE_PRIVATE_KEY=

# Resend (transactional email)
RESEND_API_KEY=
RESEND_FROM_EMAIL="Wearn <no-reply@wearn.app>"
ADMIN_NOTIFICATION_EMAIL=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Local development against the Firebase Emulator Suite
# (see .env.development.local + `npm run emulators` — NOT .env.local, see note above)
NEXT_PUBLIC_USE_FIREBASE_EMULATOR=false
